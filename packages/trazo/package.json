{
  "name": "@joycostudio/trazo",
  "version": "0.1.0",
  "description": "Deterministic code-to-diagram layout engine (flowcharts + git graphs). Pure TS core + optional React SVG renderers.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "diagram",
    "flowchart",
    "git-graph",
    "svg",
    "layout",
    "sugiyama",
    "deterministic",
    "ssr"
  ],
  "homepage": "https://github.com/joyco-studio/trazo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joyco-studio/trazo.git",
    "directory": "packages/trazo"
  },
  "bugs": {
    "url": "https://github.com/joyco-studio/trazo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "import": "./dist/eslint/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "eslint": [
        "./dist/eslint/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:glyphs": "tsx scripts/gen-glyphs.ts"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.12",
    "opentype.js": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
